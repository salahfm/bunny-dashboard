# Bunny Publisher dashboard — copy to `.env` and adjust. Every value is
# optional: the same settings can be changed from the Settings tab, and the
# dashboard works out of the box with none of this set.

# HTTP listener (default 127.0.0.1:4747).
PORT=4747
HOST=127.0.0.1

# Where db.json, the AES key file and temporary uploads live
# (default: ./data next to the project).
DATA_DIR=

# Queue defaults; both are clamped to the hard caps (10 per account, 30 accounts).
PER_ACCOUNT_CONCURRENCY=10
MAX_ACCOUNTS=30

# How files reach Bunny: `tus` uploads resumable chunks that survive dropped
# connections, `put` sends one raw request with no resume. (default: tus)
UPLOAD_MODE=tus

# TUS chunk size in bytes (default 8388608 = 8 MiB, clamped to 64 KiB - 1 GiB).
# Smaller chunks replay less data after a failure but make more requests.
TUS_CHUNK_BYTES=8388608

# Folder to watch for new video files (default: none). Files dropped there are
# matched on TMDB by filename and queued automatically; matched files are moved
# into DATA_DIR/uploads. Can also be set from the Watch tab, which wins.
WATCH_DIR=

# How often the watched folder is scanned, and how long a file must stay
# unchanged before it is picked up (defaults: 15s scan, 30s settle).
WATCH_INTERVAL_MS=15000
WATCH_MIN_AGE_MS=30000

# Queue tick and Bunny status poll intervals, in milliseconds.
TICK_INTERVAL_MS=1000
POLL_INTERVAL_MS=10000

# --- direct scraping & the relay -------------------------------------------

# Segments downloaded in parallel for a scraped stream (default 4, clamped 1-10).
STREAM_CONCURRENCY=4

# Allow the dashboard to start a Cloudflare quick tunnel, so Bunny can pull the
# relay from its own network instead of receiving the bytes from this machine.
# 0 turns it off and every scraped job then uploads directly.
SOURCE_TUNNEL=1

# Allow fetching cloudflared into .tools/ when the machine has no cloudflared.
# Set to 0 to require a binary on PATH (or CLOUDFLARED below) instead.
SOURCE_TUNNEL_DOWNLOAD=1

# Use a tunnel you run yourself instead of spawning one; the dashboard then
# serves the relay through it and never touches cloudflared.
# TUNNEL_PUBLIC_URL=https://your-tunnel.example.com

# Path to an existing cloudflared binary.
# CLOUDFLARED=C:\tools\cloudflared.exe

# Outbound calls (Bunny API, playlists): how long one attempt may take, and how
# many extra attempts follow a transport failure. A flaky path then surfaces as
# an error naming the host instead of a bare "fetch failed".
NETWORK_TIMEOUT_MS=30000
NETWORK_RETRIES=3

# --- scraping hosts ---------------------------------------------------------

# Politeness. The smallest gap between two requests to the same host, and the
# first cooldown after a host refuses (401/403/429/503 or a bot challenge); each
# further refusal doubles it, up to 30 minutes.
SCRAPER_MIN_INTERVAL_MS=350
SCRAPER_COOLDOWN_MS=60000

# Route a host through a bunny.net pull zone whose origin is that host, so the
# request leaves from Bunny's edge instead of this machine. Comma-separated
# host=base pairs:
# SCRAPER_EGRESS=vidfast.vc=https://vz-abc.b-cdn.net

# --- subtitles --------------------------------------------------------------

# Carry the stream's subtitle tracks into Bunny as caption tracks.
SUBTITLES=1

# The languages a title should end up with, in order. One code or a list: `ar`,
# `ar,fr,es` and `Arabic, French, Spanish` all read the same way (unrecognised
# entries are dropped, duplicates collapse, and the list is capped at 8). For
# every language the stream's own tracks do not cover, the best source track's
# TEXT is translated — never the audio, so no speech recognition is involved —
# and uploaded as its own caption against the same timings. Several languages
# come out of one press, and out of one read of the source text. A title that
# was already published without them can be filled in later from the Library tab.
SUBTITLE_TARGET_LANG=ar

# The text translator that fills the missing languages in. There is one engine and
# no key: DeepL, called directly on the endpoint deepl.com's own translator page
# uses (www2.deepl.com/jsonrpc), so Arabic subtitles work on a fresh install with
# nothing to sign up for. It is not a published API, so DeepL can change or
# rate-limit it at any time — a refusal is noted on the job, never fatal — and
# `off` turns translation off entirely (then only the tracks the stream already
# had are carried). An OpenAI-compatible model endpoint, an API key and a model
# name are no longer used at all: the old SUBTITLE_TRANSLATOR_KEY,
# SUBTITLE_TRANSLATOR_MODEL and DEEPL_API_KEY variables are ignored, and the
# dashboard says so at startup when they are still set.
# SUBTITLE_TRANSLATOR=off
# SUBTITLE_TRANSLATOR_URL=https://www2.deepl.com/jsonrpc

# --- R2 archive ------------------------------------------------------------

# Once a title has finished encoding, copy EVERYTHING Bunny made of it into
# Cloudflare R2 - every MP4 fallback rendition, the original file, the HLS
# playlist, every thumbnail, every animated preview, the player seek sprites
# and every caption track - verify each object against the bucket, and only
# then delete the video from Bunny. All four credentials are needed together:
# a half-filled block is a typo, so it archives nothing (and therefore deletes
# nothing) and says so at startup.
#
# Create an R2 API token with Object Read & Write on one bucket, then fill in:
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=the-token-access-key-id
# R2_SECRET_ACCESS_KEY=the-token-secret
# R2_BUCKET=bunny-archive
#
# Optional: a public base (r2.dev or a custom domain) for the archived copy.
# Playback does NOT need one: the dashboard serves an archived title by
# redirecting to a short-lived signed R2 URL, so the bucket can stay private.
# R2_PUBLIC_BASE=https://pub-abc123.r2.dev
# How long that signed URL stays valid, in seconds (default 300, clamped to
# 1 second - 7 days).
# R2_URL_TTL=300
# Optional: the folder every title is filed under (default: archive).
# R2_PREFIX=archive
# Copy finished publishes automatically (default: 1 once R2 is configured).
# R2_ARCHIVE=1
# Keep the video in Bunny after a successful archive instead of deleting it.
# R2_KEEP_BUNNY=1
# --- dashboard login --------------------------------------------------------

# Basic Auth in front of every page and API route. With no password the
# dashboard is open, which is only safe on 127.0.0.1 — the store holds your
# Bunny and TMDB credentials. /api/health and /relay/... stay open either way:
# platform health checks and Bunny Stream cannot log in.
DASHBOARD_USER=index
DASHBOARD_PASSWORD=

# Set to 1 to simulate TMDB and Bunny (same as `npm run mock`).
MOCK_PROVIDERS=0
